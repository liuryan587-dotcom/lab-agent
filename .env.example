# docker compose 用的环境变量。复制成 .env 后填写。
# 注意：.env 不要提交（已在 .gitignore 里）

# MySQL root 密码（本地演示用默认值即可）
MYSQL_ROOT_PASSWORD=root123

# JWT 密钥：生成一串随机值，例如 python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=please-change-me

# 大模型配置（必填，否则后端启动会校验失败）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 知识库 embedding。跑在容器里时指回宿主机的 Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=qwen3-embedding:8b
