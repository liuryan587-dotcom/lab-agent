# =====================================================================
# 环境变量模板，提交到 git。真实密钥填在 .env 里（.env 不要提交）
# 用法：把本文件复制成 .env，然后把下面每项的值改成你自己的
#   PowerShell:  Copy-Item .env.example .env
# =====================================================================

# ---------- 数据库（必填） ----------
# 格式：mysql+pymysql://用户名:密码@主机:端口/库名
# 注意：库名对应的 database 需要你自己先建好（建库语句见 README）
DATABASE_URL=mysql+pymysql://root:你的数据库密码@127.0.0.1:3306/lab_agent

# ---------- 登录令牌（必填） ----------
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=在这里填你自己生成的密钥
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ---------- 大模型（必填，三项都不能少） ----------
# 项目启动时会校验这三项，少任何一项都会直接启动失败
# 只要兼容 OpenAI 接口协议的都可以，base_url 记得带 /v1
#   DeepSeek:   LLM_BASE_URL=https://api.deepseek.com/v1
#               LLM_MODEL=deepseek-chat
#   阿里百炼:   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   本地 Ollama: LLM_BASE_URL=http://localhost:11434/v1
#               LLM_MODEL=qwen2.5:7b
LLM_API_KEY=sk-在这里填你的大模型APIKey
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---------- 日志（选填，不写默认 INFO） ----------
LOG_LEVEL=INFO
