# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# 环境变量：里面是数据库密码、JWT 密钥、大模型 API Key，绝对不能提交
.env

# 本地运行产生的数据
# data/chroma 是向量库的落盘文件，第一次启动后自动生成
# uploads 是用户上传的文件，一般不必提交
data/chroma/
data/*.db
uploads/

# 评估集产物：SQLite 评估库、复制的向量库、运行结果都不进 git
tests/eval/.cache/
tests/eval/results/*.json
